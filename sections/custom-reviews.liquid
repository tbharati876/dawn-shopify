{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<section id="reviews" class="assignment-reviews">
  <div class="page-width">

    <div class="assignment-reviews__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="assignment-section-heading__eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="assignment-reviews__controls">
          <button
            type="button"
            class="assignment-reviews__arrow"
            data-reviews-prev
            aria-label="Previous reviews"
          >
            ←
          </button>

          <button
            type="button"
            class="assignment-reviews__arrow"
            data-reviews-next
            aria-label="Next reviews"
          >
            →
          </button>
        </div>
      {% endif %}
    </div>

    {% if section.settings.description != blank %}
      <p class="assignment-reviews__description">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div
      class="assignment-reviews__rail"
      data-reviews-rail
      tabindex="0"
      aria-label="Customer reviews"
    >
      {% for block in section.blocks %}
        <article
          class="assignment-review-card"
          {{ block.shopify_attributes }}
        >

          <div
            class="assignment-review-card__stars"
            aria-label="{{ block.settings.rating }} out of 5 stars"
          >
            {% assign full_stars = block.settings.rating %}

            {% for i in (1..5) %}
              {% if i <= full_stars %}
                <span aria-hidden="true">★</span>
              {% else %}
                <span class="assignment-review-card__star-empty" aria-hidden="true">★</span>
              {% endif %}
            {% endfor %}
          </div>

          {% if block.settings.review != blank %}
            <blockquote class="assignment-review-card__quote">
              “{{ block.settings.review }}”
            </blockquote>
          {% endif %}

          <div class="assignment-review-card__author">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 120
                | image_tag:
                  widths: '60, 120',
                  sizes: '48px',
                  loading: 'lazy',
                  class: 'assignment-review-card__avatar',
                  alt: block.settings.name
              }}
            {% else %}
              <div
                class="assignment-review-card__avatar assignment-review-card__avatar--placeholder"
                aria-hidden="true"
              >
                {{ block.settings.name | slice: 0 }}
              </div>
            {% endif %}

            <div>
              {% if block.settings.name != blank %}
                <strong>{{ block.settings.name }}</strong>
              {% endif %}

              {% if block.settings.location != blank %}
                <span>{{ block.settings.location }}</span>
              {% endif %}
            </div>
          </div>

        </article>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Reviews rail",
  "tag": "section",
  "class": "section-assignment-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by everyday homes."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "See what customers are saying about their experience."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review text",
          "default": "A genuinely useful product with great quality. I would definitely recommend it."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location or verified text",
          "default": "Verified customer"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews rail",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}