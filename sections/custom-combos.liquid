{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<section id="combos" class="assignment-combos">
  <div class="page-width">

    <div class="assignment-section-heading">
      <span class="assignment-section-heading__eyebrow">
        {{ section.settings.eyebrow }}
      </span>

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="assignment-combos__rail">
      {% for block in section.blocks %}
        {% assign combo_product_1 = block.settings.product_1 %}
        {% assign combo_product_2 = block.settings.product_2 %}
        {% assign combo_product_3 = block.settings.product_3 %}

        <article
          class="assignment-combo-card"
          {{ block.shopify_attributes }}
        >

          <div class="assignment-combo-card__visual">

            {% if block.settings.badge != blank %}
              <span class="assignment-combo-card__badge">
                {{ block.settings.badge }}
              </span>
            {% endif %}

            <div class="assignment-combo-card__products">

              {% if combo_product_1 != blank %}
                <div class="assignment-combo-card__product">
                  {% if combo_product_1.featured_image != blank %}
                    {{
                      combo_product_1.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '180px',
                        loading: 'lazy',
                        class: 'assignment-combo-card__image',
                        alt: combo_product_1.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'assignment-combo-card__placeholder' }}
                  {% endif %}
                </div>
              {% endif %}

              {% if combo_product_2 != blank %}
                <span class="assignment-combo-card__plus" aria-hidden="true">
                  +
                </span>

                <div class="assignment-combo-card__product">
                  {% if combo_product_2.featured_image != blank %}
                    {{
                      combo_product_2.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '180px',
                        loading: 'lazy',
                        class: 'assignment-combo-card__image',
                        alt: combo_product_2.title
                    }}
                  {% else %}
                    {{ 'product-2' | placeholder_svg_tag: 'assignment-combo-card__placeholder' }}
                  {% endif %}
                </div>
              {% endif %}

              {% if combo_product_3 != blank %}
                <span class="assignment-combo-card__plus" aria-hidden="true">
                  +
                </span>

                <div class="assignment-combo-card__product">
                  {% if combo_product_3.featured_image != blank %}
                    {{
                      combo_product_3.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '180px',
                        loading: 'lazy',
                        class: 'assignment-combo-card__image',
                        alt: combo_product_3.title
                    }}
                  {% else %}
                    {{ 'product-3' | placeholder_svg_tag: 'assignment-combo-card__placeholder' }}
                  {% endif %}
                </div>
              {% endif %}

            </div>
          </div>

          <div class="assignment-combo-card__body">

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            <div class="assignment-combo-card__count">
              {% assign product_count = 0 %}

              {% if combo_product_1 != blank %}
                {% assign product_count = product_count | plus: 1 %}
              {% endif %}

              {% if combo_product_2 != blank %}
                {% assign product_count = product_count | plus: 1 %}
              {% endif %}

              {% if combo_product_3 != blank %}
                {% assign product_count = product_count | plus: 1 %}
              {% endif %}

              {{ product_count }} products
            </div>

            {% if block.settings.description != blank %}
              <p class="assignment-combo-card__description">
                {{ block.settings.description }}
              </p>
            {% endif %}

            {% assign total_price = 0 %}

            {% if combo_product_1 != blank %}
              {% assign total_price = total_price | plus: combo_product_1.price %}
            {% endif %}

            {% if combo_product_2 != blank %}
              {% assign total_price = total_price | plus: combo_product_2.price %}
            {% endif %}

            {% if combo_product_3 != blank %}
              {% assign total_price = total_price | plus: combo_product_3.price %}
            {% endif %}

            <div class="assignment-combo-card__price">
              <strong>{{ total_price | money }}</strong>
            </div>

            {% if block.settings.button_label != blank %}
              <button
                type="button"
                class="assignment-combo-card__button"
                data-combo-products="
                  {% if combo_product_1 != blank %}{{ combo_product_1.selected_or_first_available_variant.id }}{% endif %}
                  {% if combo_product_2 != blank %},{% endif %}
                  {% if combo_product_2 != blank %}{{ combo_product_2.selected_or_first_available_variant.id }}{% endif %}
                  {% if combo_product_3 != blank %},{% endif %}
                  {% if combo_product_3 != blank %}{{ combo_product_3.selected_or_first_available_variant.id }}{% endif %}
                "
              >
                {{ block.settings.button_label }}
              </button>
            {% endif %}

          </div>

        </article>
      {% endfor %}
    </div>

    {% if section.settings.rail_note != blank %}
      <p class="assignment-combos__rail-note">
        {{ section.settings.rail_note }}
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "section-assignment-combos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best-selling combos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better together."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Ready-made combinations built for everyday use."
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Bottom note",
      "default": "Choose a combo and add the selected products to your cart."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Best seller"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Everyday essentials"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A practical combination of products for everyday use."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Add combo to cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}