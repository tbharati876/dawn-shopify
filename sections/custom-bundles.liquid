{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<section id="bundles" class="assignment-bundles">
  <div class="page-width">

    <div class="assignment-section-heading assignment-section-heading--center">
      {% if section.settings.eyebrow != blank %}
        <span class="assignment-section-heading__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="assignment-bundles__grid">
      {% for block in section.blocks %}
        {% assign bundle_product_1 = block.settings.product_1 %}
        {% assign bundle_product_2 = block.settings.product_2 %}
        {% assign bundle_product_3 = block.settings.product_3 %}

        {% assign total_price = 0 %}
        {% assign product_count = 0 %}

        {% if bundle_product_1 != blank %}
          {% assign total_price = total_price | plus: bundle_product_1.price %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}

        {% if bundle_product_2 != blank %}
          {% assign total_price = total_price | plus: bundle_product_2.price %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}

        {% if bundle_product_3 != blank %}
          {% assign total_price = total_price | plus: bundle_product_3.price %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}

        <article
          class="assignment-bundle-card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.badge != blank %}
            <span class="assignment-bundle-card__badge">
              {{ block.settings.badge }}
            </span>
          {% endif %}

          <div class="assignment-bundle-card__content">

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="assignment-bundle-card__description">
                {{ block.settings.description }}
              </p>
            {% endif %}

            <div class="assignment-bundle-card__products">

              {% if bundle_product_1 != blank %}
                <div class="assignment-bundle-card__product">
                  {% if bundle_product_1.featured_image != blank %}
                    {{
                      bundle_product_1.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '(min-width: 750px) 120px, 100px',
                        loading: 'lazy',
                        class: 'assignment-bundle-card__image',
                        alt: bundle_product_1.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'assignment-bundle-card__placeholder' }}
                  {% endif %}

                  <span>{{ bundle_product_1.title }}</span>
                </div>
              {% endif %}

              {% if bundle_product_2 != blank %}
                <div class="assignment-bundle-card__product">
                  {% if bundle_product_2.featured_image != blank %}
                    {{
                      bundle_product_2.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '(min-width: 750px) 120px, 100px',
                        loading: 'lazy',
                        class: 'assignment-bundle-card__image',
                        alt: bundle_product_2.title
                    }}
                  {% else %}
                    {{ 'product-2' | placeholder_svg_tag: 'assignment-bundle-card__placeholder' }}
                  {% endif %}

                  <span>{{ bundle_product_2.title }}</span>
                </div>
              {% endif %}

              {% if bundle_product_3 != blank %}
                <div class="assignment-bundle-card__product">
                  {% if bundle_product_3.featured_image != blank %}
                    {{
                      bundle_product_3.featured_image
                      | image_url: width: 500
                      | image_tag:
                        widths: '180, 300, 500',
                        sizes: '(min-width: 750px) 120px, 100px',
                        loading: 'lazy',
                        class: 'assignment-bundle-card__image',
                        alt: bundle_product_3.title
                    }}
                  {% else %}
                    {{ 'product-3' | placeholder_svg_tag: 'assignment-bundle-card__placeholder' }}
                  {% endif %}

                  <span>{{ bundle_product_3.title }}</span>
                </div>
              {% endif %}

            </div>

            <div class="assignment-bundle-card__summary">
              <span>
                {{ product_count }} products
              </span>

              <strong>
                {{ total_price | money }}
              </strong>
            </div>

            <button
              type="button"
              class="assignment-bundle-card__button"
              data-bundle-products="
                {% if bundle_product_1 != blank %}{{ bundle_product_1.selected_or_first_available_variant.id }}{% endif %}
                {% if bundle_product_2 != blank %},{% endif %}
                {% if bundle_product_2 != blank %}{{ bundle_product_2.selected_or_first_available_variant.id }}{% endif %}
                {% if bundle_product_3 != blank %},{% endif %}
                {% if bundle_product_3 != blank %}{{ bundle_product_3.selected_or_first_available_variant.id }}{% endif %}
              "
            >
              {{ block.settings.button_label }}
            </button>

          </div>

        </article>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Custom bundles",
  "tag": "section",
  "class": "section-assignment-bundles",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bundles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your everyday setup."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Choose the combination that works best for your home."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Popular"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bundle title",
          "default": "Home essentials"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Bundle description",
          "default": "A useful collection of products selected together."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Add bundle to cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom bundles",
      "blocks": [
        {
          "type": "bundle"
        },
        {
          "type": "bundle"
        },
        {
          "type": "bundle"
        }
      ]
    }
  ]
}
{% endschema %}