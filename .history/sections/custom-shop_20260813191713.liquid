{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<section
  id="shop"
  class="assignment-shop color-{{ section.settings.color_scheme }}"
>
  <div class="page-width">

    <div class="assignment-shop__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="assignment-shop__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="assignment-shop__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="assignment-shop__view-all"
        >
          {{ section.settings.button_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div class="assignment-product-grid">

        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

          <article class="assignment-product-card">

            <a
              href="{{ product.url }}"
              class="assignment-product-card__image-wrapper"
              aria-label="{{ product.title | escape }}"
            >

              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '240, 360, 480, 640, 900',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    loading: 'lazy',
                    class: 'assignment-product-card__image',
                    alt: product.featured_image.alt | default: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'assignment-product-card__placeholder' }}
              {% endif %}

              {% unless product.available %}
                <span class="assignment-product-card__badge">
                  Sold out
                </span>
              {% endunless %}

            </a>

            <div class="assignment-product-card__content">

              <h3 class="assignment-product-card__title">
                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>
              </h3>

              <div class="assignment-product-card__price">

                {% if product.compare_at_price > product.price %}
                  <span class="assignment-product-card__price-current">
                    {{ product.price | money }}
                  </span>

                  <s class="assignment-product-card__price-compare">
                    {{ product.compare_at_price | money }}
                  </s>

                {% else %}
                  <span class="assignment-product-card__price-current">
                    {{ product.price | money }}
                  </span>
                {% endif %}

              </div>

              {% if product.available %}
                <form
                  method="post"
                  action="/cart/add"
                  class="assignment-product-card__form"
                >

                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >

                  <button
                    type="submit"
                    class="assignment-product-card__button"
                  >
                    {{ section.settings.add_to_cart_label }}
                  </button>

                </form>

              {% else %}

                <button
                  type="button"
                  class="assignment-product-card__button assignment-product-card__button--sold-out"
                  disabled
                >
                  Sold out
                </button>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="assignment-shop__empty">
        Select a collection in the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Custom shop",
  "tag": "section",
  "class": "section-assignment-shop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday essentials"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View all link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Custom shop"
    }
  ]
}
{% endschema %}